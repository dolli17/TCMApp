<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ab Android 13; gefragt wird erst beim Schalter "Mitteilungen aufs Handy" (push/PushSchalter.kt) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        allowBackup aus: siehe res/xml/sicherung.xml. Netzwerk: nur https,
        ausser in der Variante lokal (res/xml/netzwerk.xml).
    -->
    <application
        android:name=".TcmApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/sicherung"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/netzwerk"
        android:supportsRtl="false"
        android:theme="@style/Theme.TCM">

        <!--
            Push (push/PushFirebase.kt): FirebaseApp richtet TcmApp von Hand aus
            BuildConfig ein, ohne google-services.json - deshalb kein
            FirebaseInitProvider. Keine Marke vor dem Schalter (auto_init aus).
            Zeigt das System eine Nachricht selbst (App im Hintergrund), nimmt
            es Kanal, Symbol und Farbe von hier.
        -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mitteilungen" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_mitteilung" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/markenblau" />

        <service
            android:name=".push.PushDienst"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".HauptActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                App Links: der Link aus der Einladungs- und Passwortmail
                (APP_LINK_PFADE in packages/core/src/applinks.ts). Bestaetigt
                wird die Domain ueber /.well-known/assetlinks.json im Web,
                sobald dort die Fingerabdruecke stehen (ANDROID_APP_FINGERPRINTS).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="app.tennisclub-muckensturm.de" />
                <data android:host="dev.tennisclub-muckensturm.de" />
                <data android:path="/passwort-setzen" />
                <data android:pathPrefix="/passwort-setzen/" />
            </intent-filter>

            <!-- Rueckfall ohne Webadresse (lokal) und fuer Widgets: das eigene Schema je Variante -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${urlSchema}" />
            </intent-filter>
        </activity>

        <!--
            Widgets (widgets/TcmWidgets.kt): Groessen, Vorschau und Beschreibung
            in res/xml/widget_*.xml. Laden im Zeitplan per WorkManager (WidgetArbeit).
        -->
        <receiver
            android:name=".widgets.SpieleWidgetEmpfaenger"
            android:exported="true"
            android:label="@string/widget_spiele_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_spiele" />
        </receiver>
        <receiver
            android:name=".widgets.PlaetzeWidgetEmpfaenger"
            android:exported="true"
            android:label="@string/widget_plaetze_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_plaetze" />
        </receiver>
        <receiver
            android:name=".widgets.VeranstaltungWidgetEmpfaenger"
            android:exported="true"
            android:label="@string/widget_veranstaltung_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_veranstaltung" />
        </receiver>
    </application>
</manifest>
