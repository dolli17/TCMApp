<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Nur fuer den Start, bis Compose zeichnet: der Grund der App (weiss,
        im Dunkeln bg dunkel), damit nichts aufblitzt. Alles Weitere kommt
        aus TcmTheme (theme/Theme.kt).
    -->
    <style name="Theme.TCM" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/startgrund</item>
        <item name="android:windowLightStatusBar">@bool/helle_leisten</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
