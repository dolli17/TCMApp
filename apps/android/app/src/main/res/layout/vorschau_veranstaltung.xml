<?xml version="1.0" encoding="utf-8"?>
<!-- Vorschau "Nächste Veranstaltung" in der Widget-Auswahl (ab Android 12), Beispieldaten wie WidgetBeispiel -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_surf"
    android:orientation="vertical"
    android:padding="14dp"
    tools:ignore="HardcodedText,NestedWeights,Overdraw">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="IM VEREIN"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="46dp"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@color/widget_gold"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="29"
            android:textColor="@color/widget_on_gold"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="SEPT"
            android:textColor="@color/widget_on_gold"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:text="Saisonabschlussfest"
        android:textColor="@color/widget_ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:text="Di 19–23 Uhr · Clubhaus"
        android:textColor="@color/widget_ink2"
        android:textSize="12sp" />
</LinearLayout>
