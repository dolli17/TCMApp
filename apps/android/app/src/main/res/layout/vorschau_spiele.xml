<?xml version="1.0" encoding="utf-8"?>
<!-- Vorschau "Meine nächsten Spiele" in der Widget-Auswahl (ab Android 12), Beispieldaten wie WidgetBeispiel -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_brand"
    android:orientation="vertical"
    android:padding="14dp"
    tools:ignore="HardcodedText,NestedWeights,Overdraw">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="HEUTE · IN 4 STUNDEN"
        android:textColor="@color/widget_on_brand_leise"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="18:00"
        android:textColor="@color/widget_on_brand"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Platz 1 · Einzel"
        android:textColor="@color/widget_on_brand"
        android:textSize="14sp"
        android:textStyle="bold" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:text="mit Mara Beispiel"
        android:textColor="@color/widget_on_brand_leise"
        android:textSize="12sp" />
</LinearLayout>
