<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptives Launcher-Icon: Flaeche in brand, Motiv als Vektor, einfarbig fuer
    Themensymbole (Android 13+). minSdk ist 26, jedes Geraet kennt adaptive
    Icons - deshalb keine PNGs mehr in mipmap-*dpi.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/markenblau" />
    <foreground android:drawable="@drawable/ic_launcher_vordergrund" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrom" />
</adaptive-icon>
