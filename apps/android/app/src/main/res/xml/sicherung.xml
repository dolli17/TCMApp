<?xml version="1.0" encoding="utf-8"?>
<!--
    Keine Sicherung und keine Uebertragung auf ein neues Geraet: die Sitzung
    ist mit einem Schluessel aus dem Android Keystore verschluesselt, der das
    Geraet nicht verlaesst. Wiederhergestellt waere sie nur Datenmuell.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
