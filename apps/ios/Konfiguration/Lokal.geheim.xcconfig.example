// Kopie nach Lokal.geheim.xcconfig (gitignored), Werte aus apps/mobile/.env
// (EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_ANON_KEY) bzw. `supabase status`.
// Achtung: "//" ist in xcconfig ein Kommentar, deshalb http:/$()/ statt http://

SUPABASE_URL = http:/$()/127.0.0.1:54321
SUPABASE_KEY = sb_publishable_...
