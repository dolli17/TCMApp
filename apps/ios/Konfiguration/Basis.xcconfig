// Gemeinsame Werte aller Konfigurationen.
//
// Achtung: "//" leitet in xcconfig einen Kommentar ein. Adressen deshalb als
// https:/$()/beispiel.de schreiben - $() ist leer und trennt die beiden Striche.

APP_BUNDLE_ID = de.tcmuckensturm.app
// Wird je Konfiguration gesetzt: leer (Prod), .dev, .lokal
APP_BUNDLE_SUFFIX =
PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID)$(APP_BUNDLE_SUFFIX)
TCM_ANZEIGENAME = TC Muckensturm

// App Group, zugleich Access Group des Schluesselbunds - geteilt mit den Widgets.
// Je Konfiguration eine eigene Gruppe, damit Dev und Prod sich nichts teilen.
// Aus der Bundle-ID der App, nicht PRODUCT_BUNDLE_IDENTIFIER: die Erweiterung
// heisst <app>.widgets und muss dieselbe Gruppe haben.
APP_GROUP = group.$(APP_BUNDLE_ID)$(APP_BUNDLE_SUFFIX)

// Web-Adresse fuer Antrag, Impressum usw. Leer: die Verweise bleiben weg.
// Auch Ziel des Links aus "Passwort vergessen" (<SITE_URL>/passwort-setzen,
// Universal Link); ohne SITE_URL nimmt die App ihr eigenes URL-Schema.
SITE_URL =

// Eigenes URL-Schema, Rueckfall fuer Links aus der E-Mail (tcm://passwort-setzen).
// Je Konfiguration ein eigenes, damit Dev und Prod nebeneinander installiert sein koennen.
APP_URL_SCHEME = tcm

// APNs-Umgebung (Entitlement aps-environment). Marken aus development gelten nur
// in der Sandbox von APNs (APNS_UMGEBUNG=sandbox an der Edge Function, docs/native-apps.md).
// Beim Export fuer TestFlight/App Store setzt Xcode ohnehin production.
APS_UMGEBUNG = production
