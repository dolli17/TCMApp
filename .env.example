# Vorlage fuer die lokalen Env-Dateien. Kopie als .env (bzw. apps/web/.env.local,
# apps/mobile/.env) anlegen und ausfuellen. Alle .env* sind gitignored und duerfen
# das Repo nie verlassen. Hier stehen nur Namen und unkritische Standardwerte.
#
# Wo die Werte in den Cloud-Umgebungen liegen (Details: CONTRIBUTING.md):
#   - Web:            Server, /docker/tcm-web*/.env (NEXT_PUBLIC_*, APP_DOMAIN)
#   - iOS-App:        apps/mobile/eas.json, je Build-Profil (EXPO_PUBLIC_*)
#   - Edge Functions: "supabase secrets set" je Projekt (RESEND_API_KEY, ...)
#   - Deploy:         GitHub-Environments dev/production (SUPABASE_ACCESS_TOKEN, ...)
# Prod-Schluessel gehoeren nie in eine Datei auf dem Mac, nur in den Passwortmanager.

# ---------------------------------------------------------------------------
# Supabase (Client) - lokal: http://127.0.0.1:54321, sonst https://<ref>.supabase.co
# ---------------------------------------------------------------------------
# Oeffentlich, darf im Client stehen
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Expo braucht dieselben Werte unter eigenem Praefix
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Basisadresse der Web-App fuer Links aus der App (Datenschutz, Impressum)
EXPO_PUBLIC_SITE_URL=

# Basisadresse der Web-App. Steht in den Einladungs- und
# Passwortlinks; muss in Supabase unter "Redirect URLs" eingetragen sein.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NIEMALS im Client verwenden. Nur fuer Seed, Import und Tests auf dem eigenen Rechner.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Zugangsverwaltung
#
# Die Edge Function "member-login" verschickt Einladungen und sperrt Konten.
# Sie braucht den Service-Schluessel - der steht ausschliesslich in ihrer
# eigenen Umgebung ("supabase secrets set") und niemals hier oder in einer
# NEXT_PUBLIC_-Variablen.
#
# SUPABASE_FUNCTIONS_URL ist optional: fehlt sie, wird sie aus
# NEXT_PUBLIC_SUPABASE_URL abgeleitet. Lokal zeigt sie auf
# http://127.0.0.1:54321/functions/v1
# ---------------------------------------------------------------------------
SUPABASE_FUNCTIONS_URL=

# ---------------------------------------------------------------------------
# E2E-Tests (apps/web/e2e) - Testkonten aus seed.sql, nur lokal
# E2E_BASE_URL ist optional (Default http://localhost:3000).
# ---------------------------------------------------------------------------
DEV_PASSWORD=
DEV_USER_ADMIN=
DEV_USER_MEMBER=
DEV_USER_KIOSK=
# Offenes Onboarding: erwachsen ohne Mandat bzw. minderjaehrig
DEV_USER_NEU=
DEV_USER_KIND=
E2E_BASE_URL=

# ---------------------------------------------------------------------------
# eBuSy-Import (tools/import)
# ---------------------------------------------------------------------------
EBUSY_BASE_URL=https://tennisclub-muckensturm.ebusy.de/api
EBUSY_USER=
EBUSY_PASSWORD=
EBUSY_MEMBER_MODULE_ID=2828
EBUSY_COURT_MODULE_ID=2439

# ---------------------------------------------------------------------------
# Edge-Function-Secrets. In der Cloud per "supabase secrets set", lokal hier.
# SUPABASE_URL, SUPABASE_ANON_KEY und SUPABASE_SERVICE_ROLE_KEY setzt Supabase
# in den Functions selbst.
#
# Ohne RESEND_API_KEY laeuft notification-mails im Trockenlauf: sie zeigt in
# der Antwort den fertigen Mailtext samt Empfaenger, verschickt aber nichts.
# Ohne PUSH_AKTIV=true gilt dasselbe fuer notification-pushes.
# ---------------------------------------------------------------------------
SITE_URL=
RESEND_API_KEY=
MAIL_FROM="TC Muckensturm <noreply@example.org>"
EXPO_ACCESS_TOKEN=
PUSH_AKTIV=

# ---------------------------------------------------------------------------
# Verschluesselung der IBANs (32 Byte, base64). In der Cloud liegt der
# Schluessel in Supabase Vault (iban_encryption_key); hier nur fuer lokale Tests.
# ---------------------------------------------------------------------------
IBAN_ENCRYPTION_KEY=
