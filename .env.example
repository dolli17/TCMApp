# Kopie als .env anlegen und ausfuellen. .env ist gitignored und darf das Repo nie verlassen.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Oeffentlich, darf im Client stehen
NEXT_PUBLIC_SUPABASE_URL=https://xvjqqjiweogtfpfgeoqz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Expo braucht dieselben Werte unter eigenem Praefix
EXPO_PUBLIC_SUPABASE_URL=https://xvjqqjiweogtfpfgeoqz.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NIEMALS im Client verwenden. Nur fuer Seed, Import und Tests auf dem eigenen Rechner.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# eBuSy – wird erst in Phase 5 (Import & Cutover) gebraucht
# ---------------------------------------------------------------------------
EBUSY_BASE_URL=https://tennisclub-muckensturm.ebusy.de/api
EBUSY_USER=
EBUSY_PASSWORD=
EBUSY_MEMBER_MODULE_ID=2828
EBUSY_COURT_MODULE_ID=2439

# ---------------------------------------------------------------------------
# E-Mail-Versand (Pre-Notification, Einladungen)
# Leer lassen -> es wird der Log-Adapter benutzt, der nichts verschickt.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM="TC Muckensturm <noreply@example.org>"

# ---------------------------------------------------------------------------
# Verschluesselung der IBANs (32 Byte, base64). Produktiv liegt der Schluessel
# in Supabase Vault; hier nur fuer lokale Tests.
# ---------------------------------------------------------------------------
IBAN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Zugangsverwaltung
#
# Die Edge Function "member-login" verschickt Einladungen und sperrt Konten.
# Sie braucht den Service-Schluessel - der steht ausschliesslich in ihrer
# eigenen Umgebung ("supabase secrets set") und niemals hier oder in einer
# NEXT_PUBLIC_-Variablen.
#
# SUPABASE_FUNCTIONS_URL ist optional: fehlt sie, wird sie aus
# NEXT_PUBLIC_SUPABASE_URL abgeleitet. Lokal zeigt sie auf
# http://127.0.0.1:54321/functions/v1
# ---------------------------------------------------------------------------
SUPABASE_FUNCTIONS_URL=

# Basisadresse der Web-App. Steht in den Einladungs- und
# Passwortlinks; muss in Supabase unter "Redirect URLs" eingetragen sein.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
